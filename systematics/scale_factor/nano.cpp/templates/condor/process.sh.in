#!/usr/bin/env bash

set -euo pipefail

log_step() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" >&2
}

random_sleep_up_to() {
  local max_seconds=$1
  local reason=$2
  if [[ "${max_seconds}" =~ ^[0-9]+$ ]] && (( max_seconds > 0 )); then
    local delay=$(( ( RANDOM % max_seconds ) + 1 ))
    log_step "${reason}: sleeping ${delay}s (max ${max_seconds}s)"
    sleep "${delay}"
  fi
}

random_sleep_up_to "${SCALE_FACTOR_STARTUP_JITTER_MAX:-900}" "Startup jitter"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

STAGED_X509_PROXY="${SCRIPT_DIR}/x509up_proxy"
if [[ -f "${STAGED_X509_PROXY}" ]]; then
  chmod 600 "${STAGED_X509_PROXY}" 2>/dev/null || true
  export X509_USER_PROXY="${STAGED_X509_PROXY}"
  log_step "Using staged X509 proxy: ${X509_USER_PROXY}"
fi

export XRD_NETWORKSTACK="${XRD_NETWORKSTACK:-IPv4}"
export XRD_CONNECTIONWINDOW="${XRD_CONNECTIONWINDOW:-30}"
export XRD_REQUESTTIMEOUT="${XRD_REQUESTTIMEOUT:-120}"
export SCALE_FACTOR_XRD_REDIRECTORS="${SCALE_FACTOR_XRD_REDIRECTORS:-cms-xrd-global.cern.ch,cmsxrootd.fnal.gov,xrootd-cms.infn.it}"
export SCALE_FACTOR_XRD_STAT_TIMEOUT="${SCALE_FACTOR_XRD_STAT_TIMEOUT:-30}"
export SCALE_FACTOR_XRD_YIYANGZ_PREFIX="${SCALE_FACTOR_XRD_YIYANGZ_PREFIX:-root://cceos.ihep.ac.cn//eos/ihep/cms}"
export SCALE_FACTOR_XRD_YIYANGZ_COPY_JITTER_MAX="${SCALE_FACTOR_XRD_YIYANGZ_COPY_JITTER_MAX:-240}"
export SCALE_FACTOR_XRD_MAX_ROUNDS="${SCALE_FACTOR_XRD_MAX_ROUNDS:-3}"
export SCALE_FACTOR_XRD_RETRY_WAIT_MIN="${SCALE_FACTOR_XRD_RETRY_WAIT_MIN:-30}"
export SCALE_FACTOR_XRD_RETRY_WAIT_JITTER="${SCALE_FACTOR_XRD_RETRY_WAIT_JITTER:-120}"

DAS_HOME="@DAS_HOME@"

if [[ -n "${DAS_HOME}" ]]; then
  if [[ ! -d "${DAS_HOME}" ]]; then
    echo "Error: generated DAS HOME is not accessible on this worker: ${DAS_HOME}" >&2
    exit 1
  fi
  export HOME="${DAS_HOME}"
  export SCALE_FACTOR_DAS_HOME="${DAS_HOME}"
fi

WORKDIR=$(pwd)

hash_file() {
  local path=$1
  if ! command -v sha256sum >/dev/null 2>&1; then
    echo "Error: sha256sum is required on the worker" >&2
    exit 1
  fi
  sha256sum "${path}" | awk '{print substr($1, 1, 16)}'
}

REPO_STAMP="$(hash_file repo.tar.gz)"
REPO_DIR="${WORKDIR}/repo_${REPO_STAMP}"
EXTRACT_STAMP="${REPO_DIR}/.extract_complete_${REPO_STAMP}"
EXTRACT_LOCK="${WORKDIR}/.extract_${REPO_STAMP}.lock"

RUNTIME_STAMP="$(hash_file worker_runtime.tar.gz)"
RUNTIME_DIR="${WORKDIR}/worker_runtime_${RUNTIME_STAMP}"
RUNTIME_STAMP_FILE="${RUNTIME_DIR}/.extract_complete_${RUNTIME_STAMP}"
RUNTIME_LOCK="${WORKDIR}/.runtime_${RUNTIME_STAMP}.lock"

if ! command -v flock >/dev/null 2>&1; then
  echo "Error: flock is required to serialize shared Condor worker setup" >&2
  exit 1
fi

(
  flock 200
  if [ ! -f "${EXTRACT_STAMP}" ]; then
    mkdir -p "${REPO_DIR}"
    tar -xzf repo.tar.gz -C "${REPO_DIR}" --strip-components=0
    touch "${EXTRACT_STAMP}"
  fi
) 200>"${EXTRACT_LOCK}"

(
  flock 200
  if [ ! -f "${RUNTIME_STAMP_FILE}" ]; then
    mkdir -p "${RUNTIME_DIR}"
    tar -xzf worker_runtime.tar.gz -C "${RUNTIME_DIR}"
    touch "${RUNTIME_STAMP_FILE}"
  fi
) 200>"${RUNTIME_LOCK}"

if [[ ! -x "${RUNTIME_DIR}/build/nano_run" ]]; then
  echo "Error: bundled nano_run is missing or not executable: ${RUNTIME_DIR}/build/nano_run" >&2
  exit 1
fi

have_site_tools() {
  command -v hadd >/dev/null 2>&1 && command -v xrdcp >/dev/null 2>&1 && command -v xrdfs >/dev/null 2>&1
}

discover_lcg_setup() {
  local setup="/cvmfs/sft.cern.ch/lcg/views/LCG_109/x86_64-el9-gcc13-opt/setup.sh"
  if [[ -f "${setup}" ]]; then
    echo "${setup}"
    return 0
  fi

  if [[ -d /cvmfs/sft.cern.ch/lcg/views ]]; then
    return 2
  fi
  return 1
}

source_setup_file() {
  local setup=$1
  local saved_flags=$-
  local rc=0

  set +e
  set +u
  # shellcheck disable=SC1090
  source "${setup}"
  rc=$?

  case "${saved_flags}" in
    *e*) set -e ;;
    *) set +e ;;
  esac
  case "${saved_flags}" in
    *u*) set -u ;;
    *) set +u ;;
  esac

  return "${rc}"
}

setup_site_tools() {
  local setup=""
  local setup_status=0
  setup="$(discover_lcg_setup)" || setup_status=$?
  if [[ "${setup_status}" == 0 ]]; then
    if ! source_setup_file "${setup}"; then
      echo "Error: failed to source fixed CVMFS LCG setup: ${setup}" >&2
      exit 1
    fi
    SCALE_FACTOR_SITE_SETUP="${setup}"
  elif [[ "${setup_status}" == 2 ]]; then
    echo "Error: fixed CVMFS LCG setup is missing on this worker: /cvmfs/sft.cern.ch/lcg/views/LCG_109/x86_64-el9-gcc13-opt/setup.sh" >&2
    exit 1
  elif have_site_tools; then
    SCALE_FACTOR_SITE_SETUP="worker environment"
  fi

  if ! have_site_tools && [[ -r /cvmfs/cms.cern.ch/cmsset_default.sh ]]; then
    source_setup_file /cvmfs/cms.cern.ch/cmsset_default.sh >/dev/null 2>&1 || true
    SCALE_FACTOR_SITE_SETUP="${SCALE_FACTOR_SITE_SETUP:-/cvmfs/cms.cern.ch/cmsset_default.sh}"
  fi

  if ! have_site_tools; then
    echo "Error: worker site environment does not provide required tools: hadd, xrdcp, xrdfs." >&2
    echo "The fixed LCG view should provide them on lxplus: /cvmfs/sft.cern.ch/lcg/views/LCG_109/x86_64-el9-gcc13-opt." >&2
    exit 127
  fi
}

setup_site_tools
SITE_PATH="${PATH}"
SITE_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
SITE_ROOTSYS="${ROOTSYS:-}"
SITE_PYTHONPATH="${PYTHONPATH:-}"
SITE_HADD="$(command -v hadd)"
SITE_XRDCP="$(command -v xrdcp)"
SITE_XRDFS="$(command -v xrdfs)"
SITE_ROOT_CONFIG="$(command -v root-config 2>/dev/null || true)"

RUNTIME_LD_DIRS=("${RUNTIME_DIR}/build" "${RUNTIME_DIR}/build/external/CMSJMECalculators" "${RUNTIME_DIR}/env/lib")
if [[ -f "${RUNTIME_DIR}/runtime_ld_paths.txt" ]]; then
  while IFS= read -r rel_dir; do
    [[ -z "${rel_dir}" ]] && continue
    if [[ -d "${RUNTIME_DIR}/${rel_dir}" ]]; then
      RUNTIME_LD_DIRS+=("${RUNTIME_DIR}/${rel_dir}")
    fi
  done < "${RUNTIME_DIR}/runtime_ld_paths.txt"
fi

RUNTIME_LD_PATH="$(IFS=:; echo "${RUNTIME_LD_DIRS[*]}")"
export NANO_RUN="${RUNTIME_DIR}/build/nano_run"
NANO_PATH="${RUNTIME_DIR}/env/bin:${SITE_PATH}"
NANO_ROOTSYS="${RUNTIME_DIR}/env"
if [[ ! -d "${NANO_ROOTSYS}" ]]; then
  NANO_ROOTSYS="${SITE_ROOTSYS}"
fi
NANO_LD_LIBRARY_PATH="${RUNTIME_LD_PATH}"
if [[ -n "${SITE_LD_LIBRARY_PATH}" ]]; then
  NANO_LD_LIBRARY_PATH="${NANO_LD_LIBRARY_PATH}:${SITE_LD_LIBRARY_PATH}"
fi
log_step "Using bundled worker runtime: ${RUNTIME_DIR}"
log_step "Using site tool setup: ${SCALE_FACTOR_SITE_SETUP:-none}"
log_step "Site tools: hadd=${SITE_HADD} xrdcp=${SITE_XRDCP} xrdfs=${SITE_XRDFS} root-config=${SITE_ROOT_CONFIG:-missing}"

JOB_INDEX=$1
TREE_NAME=$2
NUM_EVENTS=$3
CONFIG=$4
CHANNEL=$5
VARIATIONS=$6
RUN_DATA=$7
DOWNLOAD_FILE="${DOWNLOAD_FILE:-${8:-false}}"

STAGE_DIR="${_CONDOR_SCRATCH_DIR:-${TMPDIR:-${WORKDIR}}}"
mkdir -p "${STAGE_DIR}"

LOCAL_OUTPUT="${STAGE_DIR}/local_output_${JOB_INDEX}.root"

if [[ "${CONFIG}" != /* ]]; then
  CONFIG="${WORKDIR}/${CONFIG}"
fi

MANIFEST_LINE="$(awk -F '\t' -v idx="${JOB_INDEX}" '$1 == idx {print; found=1; exit} END {if (!found) exit 1}' job_manifest.tsv)" || {
  echo "No manifest entry for job ${JOB_INDEX}" >&2
  exit 1
}
IFS=$'\t' read -r MANIFEST_INDEX FINAL_OUTPUT INPUTS <<< "${MANIFEST_LINE}"
if [[ "${MANIFEST_INDEX}" != "${JOB_INDEX}" || -z "${FINAL_OUTPUT}" || -z "${INPUTS}" ]]; then
  echo "Malformed manifest entry for job ${JOB_INDEX}: ${MANIFEST_LINE}" >&2
  exit 1
fi

LOCAL_STEM="${LOCAL_OUTPUT%.root}"
FINAL_STEM="${FINAL_OUTPUT%.root}"

should_download() {
  case "$1" in
    true|TRUE|True|1|yes|YES|y|Y|on|ON|On) return 0 ;;
    *) return 1 ;;
  esac
}

is_remote_input() {
  local path=$1
  [[ "${path}" == root://* ]]
}

variation_file() {
  local base=$1
  local variation=$2

  if [[ "${base}" == *.root ]]; then
    echo "${base%.root}_${variation}.root"
  else
    echo "${base}_${variation}"
  fi
}

run_one_input() {
  local input=$1
  local output=$2
  local cmd=(
    "${NANO_RUN}"
    --input-files "${input}"
    --output-file "${output}"
    --tree-name "${TREE_NAME}"
    --num-events "${NUM_EVENTS}"
    --channel "${CHANNEL}"
    --config "${CONFIG}"
  )

  cmd+=(--variations "${VARIATIONS}")
  if should_download "${RUN_DATA}"; then
    cmd+=(--run-data)
  fi

  printf "Running command:"
  printf " %q" "${cmd[@]}"
  printf "\n"

  (cd "${REPO_DIR}" && env PATH="${NANO_PATH}" ROOTSYS="${NANO_ROOTSYS}" LD_LIBRARY_PATH="${NANO_LD_LIBRARY_PATH}" "${cmd[@]}")
}

parse_variations() {
  local in_var=$1
  IFS=',' read -r -a out <<< "${in_var}"
  for v in "${out[@]}"; do
    [[ -n "${v}" ]] && echo "${v}"
  done
}

IFS=',' read -r -a RAW_INPUTS <<< "${INPUTS}"
if (( ${#RAW_INPUTS[@]} == 0 )); then
  echo "No input files in manifest job ${JOB_INDEX}" >&2
  exit 1
fi

DOWNLOAD_REMOTE=false
if should_download "${DOWNLOAD_FILE}"; then
  for input_file in "${RAW_INPUTS[@]}"; do
    if is_remote_input "${input_file}"; then
      DOWNLOAD_REMOTE=true
      break
    fi
  done
fi

WORK_INPUTS=()
TO_CLEAN=()
WORK_INPUTS=("${RAW_INPUTS[@]}")

run_limited() {
  local seconds=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "${seconds}" "$@"
  else
    "$@"
  fi
}

remote_host() {
  local remote=$1
  local without_scheme="${remote#root://}"
  echo "${without_scheme%%/*}"
}

remote_path() {
  local remote=$1
  local without_scheme="${remote#root://}"
  local host="${without_scheme%%/*}"
  local path="${without_scheme#${host}}"
  while [[ "${path}" == //* ]]; do
    path="${path#/}"
  done
  if [[ "${path}" != /* ]]; then
    path="/${path}"
  fi
  echo "${path}"
}

is_yiyangz_remote_input() {
  local remote=$1
  local path
  path="$(remote_path "${remote}")"
  case "${path}" in
    /store/user/yiyangz/*|/eos/ihep/cms/store/user/yiyangz/*) return 0 ;;
    *) return 1 ;;
  esac
}

yiyangz_ihep_remote() {
  local source_file=$1
  local source_path
  source_path="$(remote_path "${source_file}")"

  case "${source_path}" in
    /store/user/yiyangz/*)
      echo "${SCALE_FACTOR_XRD_YIYANGZ_PREFIX%/}${source_path}"
      return 0
      ;;
    /eos/ihep/cms/store/user/yiyangz/*)
      echo "root://cceos.ihep.ac.cn/${source_path}"
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

retry_wait_seconds() {
  local min_seconds="${SCALE_FACTOR_XRD_RETRY_WAIT_MIN}"
  local jitter_seconds="${SCALE_FACTOR_XRD_RETRY_WAIT_JITTER}"

  [[ "${min_seconds}" =~ ^[0-9]+$ ]] || min_seconds=30
  [[ "${jitter_seconds}" =~ ^[0-9]+$ ]] || jitter_seconds=120

  echo $(( min_seconds + (jitter_seconds > 0 ? RANDOM % (jitter_seconds + 1) : 0) ))
}

diagnose_remote_input() {
  local remote=$1
  local host
  local path
  host="$(remote_host "${remote}")"
  path="$(remote_path "${remote}")"

  log_step "Remote input diagnostic: host=${host} path=${path}"
  if [[ -x "${SITE_XRDFS}" ]]; then
    log_step "Running xrdfs stat with ${SCALE_FACTOR_XRD_STAT_TIMEOUT}s limit"
    if run_limited "${SCALE_FACTOR_XRD_STAT_TIMEOUT}" "${SITE_XRDFS}" "root://${host}" stat "${path}" >&2; then
      log_step "xrdfs stat succeeded for ${remote}"
    else
      log_step "Warning: xrdfs stat failed or timed out for ${remote}"
    fi
  else
    log_step "Warning: xrdfs is not available from the resolved site tools"
  fi
}

candidate_remote_inputs() {
  local source_file=$1
  local source_host
  local source_path
  source_host="$(remote_host "${source_file}")"
  source_path="$(remote_path "${source_file}")"

  local ihep_source=""
  if ihep_source="$(yiyangz_ihep_remote "${source_file}")"; then
    echo "${ihep_source}"
    return
  fi

  echo "${source_file}"

  local seen=",${source_host},"
  local redirector
  IFS=',' read -r -a redirectors <<< "${SCALE_FACTOR_XRD_REDIRECTORS}"
  for redirector in "${redirectors[@]}"; do
    redirector="${redirector//[[:space:]]/}"
    [[ -z "${redirector}" ]] && continue
    case "${seen}" in
      *",${redirector},"*) continue ;;
    esac
    seen="${seen}${redirector},"
    echo "root://${redirector}/${source_path}"
  done
}

log_step "Job context: job_index=${JOB_INDEX} host=$(hostname -f 2>/dev/null || hostname) workdir=${WORKDIR} stage_dir=${STAGE_DIR}"
log_step "Input staging: DOWNLOAD_FILE=${DOWNLOAD_FILE} XRD_NETWORKSTACK=${XRD_NETWORKSTACK} XRD_CONNECTIONWINDOW=${XRD_CONNECTIONWINDOW} XRD_REQUESTTIMEOUT=${XRD_REQUESTTIMEOUT} SCALE_FACTOR_XRD_REDIRECTORS=${SCALE_FACTOR_XRD_REDIRECTORS} SCALE_FACTOR_XRD_YIYANGZ_PREFIX=${SCALE_FACTOR_XRD_YIYANGZ_PREFIX}"
log_step "Tools: xrdcp=${SITE_XRDCP} xrdfs=${SITE_XRDFS} hadd=${SITE_HADD} voms-proxy-info=$(command -v voms-proxy-info 2>/dev/null || echo missing)"
if [[ -n "${X509_USER_PROXY:-}" ]]; then
  log_step "X509_USER_PROXY=${X509_USER_PROXY}"
  ls -l "${X509_USER_PROXY}" >&2 2>/dev/null || true
  if command -v voms-proxy-info >/dev/null 2>&1; then
    log_step "Proxy time left:"
    voms-proxy-info -timeleft >&2 || true
  fi
else
  log_step "Warning: X509_USER_PROXY is not set"
fi
log_step "Resolved manifest inputs (${#RAW_INPUTS[@]} files):"
for input_file in "${RAW_INPUTS[@]}"; do
  log_step "  ${input_file}"
done

prepare_input() {
  local index=$1
  local source_file=$2
  local max_rounds="${SCALE_FACTOR_XRD_MAX_ROUNDS}"
  local round=1

  [[ "${max_rounds}" =~ ^[0-9]+$ ]] || max_rounds=3
  (( max_rounds > 0 )) || max_rounds=1

  if [[ "${DOWNLOAD_REMOTE}" == "true" && "${source_file}" == root://* ]]; then
    local local_name="${STAGE_DIR}/download_${JOB_INDEX}_${index}_$(basename "${source_file}")"
    mapfile -t SOURCE_CANDIDATES < <(candidate_remote_inputs "${source_file}")
    if is_yiyangz_remote_input "${source_file}"; then
      if [[ "${SOURCE_CANDIDATES[0]}" != "${source_file}" ]]; then
        log_step "Rewriting yiyangz input source: ${source_file} -> ${SOURCE_CANDIDATES[0]}"
      fi
      random_sleep_up_to "${SCALE_FACTOR_XRD_YIYANGZ_COPY_JITTER_MAX}" "yiyangz input copy jitter"
    fi
    log_step "Copying remote input to ${local_name}"
    for candidate in "${SOURCE_CANDIDATES[@]}"; do
      log_step "  candidate: ${candidate}"
    done
    while (( round <= max_rounds )); do
      local candidate
      for candidate in "${SOURCE_CANDIDATES[@]}"; do
        diagnose_remote_input "${candidate}"
        log_step "xrdcp attempt round ${round}/${max_rounds}: ${candidate}"
        if "${SITE_XRDCP}" -f --nopbar "${candidate}" "${local_name}"; then
          ls -lh "${local_name}" >&2 || true
          log_step "Copied remote input from ${candidate} to ${local_name}"
          TO_CLEAN+=("${local_name}")
          echo "${local_name}"
          return
        fi
        log_step "Warning: xrdcp failed for ${candidate} in round ${round}/${max_rounds}" >&2
      done
      if (( round >= max_rounds )); then
        log_step "Error: failed to copy ${source_file} to ${local_name} after ${max_rounds} rounds over ${#SOURCE_CANDIDATES[@]} redirector candidates" >&2
        return 1
      fi
      local wait_seconds
      wait_seconds="$(retry_wait_seconds)"
      log_step "Warning: all xrdcp candidates failed for ${source_file} in round ${round}/${max_rounds}; retrying in ${wait_seconds}s" >&2
      sleep "${wait_seconds}"
      round=$((round + 1))
    done
  fi

  echo "${source_file}"
}

if [[ "${DOWNLOAD_REMOTE}" == "false" ]]; then
  run_one_input "${INPUTS}" "${LOCAL_OUTPUT}"
else
  mapfile -t VARIATION_NAMES < <(parse_variations "${VARIATIONS}")
  for i in "${!WORK_INPUTS[@]}"; do
    input_file="$(prepare_input "${i}" "${WORK_INPUTS[$i]}")"
    piece_base="${STAGE_DIR}/piece_${JOB_INDEX}_${i}"
    run_one_input "${input_file}" "${piece_base}"
    TO_CLEAN+=("${piece_base}" "${piece_base}.root")
  done

  for var in "${VARIATION_NAMES[@]}"; do
    VARIANT_FILES=()
    for i in "${!WORK_INPUTS[@]}"; do
      piece_base="${STAGE_DIR}/piece_${JOB_INDEX}_${i}"
      piece_var="$(variation_file "${piece_base}" "${var}")"
      VARIANT_FILES+=("${piece_var}")
      TO_CLEAN+=("${piece_var}")
    done

    local_var_output="$(variation_file "${LOCAL_OUTPUT}" "${var}")"
    if (( ${#VARIANT_FILES[@]} == 1 )); then
      mv -f "${VARIANT_FILES[0]}" "${local_var_output}"
    else
      echo "Merging ${#VARIANT_FILES[@]} pieces into ${local_var_output} (variation=${var})"
      "${SITE_HADD}" -f "${local_var_output}" "${VARIANT_FILES[@]}"
    fi
  done
fi

declare -A REMOTE_PARENT_READY=()

ensure_remote_parent() {
  local remote=$1
  local without_scheme="${remote#root://}"
  local host="${without_scheme%%/*}"
  local path="${without_scheme#${host}}"
  local parent
  local key

  while [[ "${path}" == //* ]]; do
    path="${path#/}"
  done
  if [[ "${path}" != /* ]]; then
    path="/${path}"
  fi
  parent="${path%/*}"
  [[ -n "${parent}" ]] || parent="/"
  key="${host}|${parent}"
  if [[ -n "${REMOTE_PARENT_READY[${key}]:-}" ]]; then
    return
  fi

  log_step "Creating remote output directory root://${host}${parent}"
  "${SITE_XRDFS}" "root://${host}" mkdir -p "${parent}"
  REMOTE_PARENT_READY["${key}"]=1
}

copy_output() {
  local local_file=$1
  local final_file=$2

  if [[ "${final_file}" == root://* ]]; then
    ensure_remote_parent "${final_file}"
    log_step "Copying ${local_file} to ${final_file}"
    "${SITE_XRDCP}" --silent -p -f "${local_file}" "${final_file}"
  elif [[ "${final_file}" == /eos/cms* ]]; then
    local eos_host="root://eoscms.cern.ch"
    local remote_output="${eos_host}//${final_file}"
    log_step "Copying ${local_file} to ${remote_output}"
    "${SITE_XRDCP}" --silent -p -f "${local_file}" "${remote_output}"
  elif [[ "${final_file}" == /eos/user* ]]; then
    local eos_host="root://eosuser.cern.ch"
    local remote_output="${eos_host}//${final_file}"
    log_step "Copying ${local_file} to ${remote_output}"
    "${SITE_XRDCP}" --silent -p -f "${local_file}" "${remote_output}"
  elif [[ "${final_file}" == /eos/uscms* ]]; then
    local eos_host="root://cmseos.fnal.gov"
    local remote_output="${eos_host}//${final_file}"
    log_step "Copying ${local_file} to ${remote_output}"
    "${SITE_XRDCP}" --silent -p -f "${local_file}" "${remote_output}"
  else
    mkdir -p "$(dirname "${final_file}")"
    log_step "Copying ${local_file} to ${final_file}"
    cp "${local_file}" "${final_file}"
  fi
}

shopt -s nullglob
copied=0

for local_file in "${LOCAL_STEM}"_*.root; do
  suffix="${local_file#${LOCAL_STEM}}"
  copy_output "${local_file}" "${FINAL_STEM}${suffix}"
  copied=$((copied + 1))
done

if [[ ${copied} -eq 0 ]]; then
  echo "No variation output files matched ${LOCAL_STEM}_*.root" >&2
  exit 1
fi

for file in "${TO_CLEAN[@]}"; do
  rm -f "${file}"
done

touch ${WORKDIR}/dummy.cc
