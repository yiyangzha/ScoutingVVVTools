#!/usr/bin/env bash

sleep $(( ( RANDOM % 200 ) + 1 ))

set -euo pipefail

log_step() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" >&2
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"
touch "${SCRIPT_DIR}/dummy.cc"

STAGED_X509_PROXY="${SCRIPT_DIR}/x509up_proxy"
if [[ -f "${STAGED_X509_PROXY}" ]]; then
  chmod 600 "${STAGED_X509_PROXY}" 2>/dev/null || true
  export X509_USER_PROXY="${STAGED_X509_PROXY}"
  log_step "Using staged X509 proxy: ${X509_USER_PROXY}"
fi

export XRD_NETWORKSTACK="${XRD_NETWORKSTACK:-IPv4}"
export XRD_CONNECTIONWINDOW="${XRD_CONNECTIONWINDOW:-30}"
export XRD_REQUESTTIMEOUT="${XRD_REQUESTTIMEOUT:-120}"
export SCALE_FACTOR_XRD_REDIRECTORS="${SCALE_FACTOR_XRD_REDIRECTORS:-cms-xrd-global.cern.ch,cmsxrootd.fnal.gov,xrootd-cms.infn.it}"
export SCALE_FACTOR_XRD_STAT_TIMEOUT="${SCALE_FACTOR_XRD_STAT_TIMEOUT:-30}"

DAS_HOME="@DAS_HOME@"
if [[ -n "${DAS_HOME}" ]]; then
  if [[ ! -d "${DAS_HOME}" ]]; then
    echo "Error: generated DAS HOME is not accessible on this worker: ${DAS_HOME}" >&2
    exit 1
  fi
  export HOME="${DAS_HOME}"
  export SCALE_FACTOR_DAS_HOME="${DAS_HOME}"
fi

CONDA_PREFIX="@CONDA_PREFIX@"
if [[ -z "${CONDA_PREFIX}" || ! -d "${CONDA_PREFIX}" ]]; then
  echo "Error: generated CONDA_PREFIX is not accessible on this worker: ${CONDA_PREFIX}" >&2
  exit 1
fi

export CONDA_PREFIX
export PATH="${CONDA_PREFIX}/bin:${PATH}"
export ROOTSYS="${CONDA_PREFIX}"
export CMAKE_PREFIX_PATH="@CMAKE_PREFIX_PATH_ENV@"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
export LIBRARY_PATH="${CONDA_PREFIX}/lib:${LIBRARY_PATH:-}"
export CPATH="${CONDA_PREFIX}/include:${CPATH:-}"
export CPLUS_INCLUDE_PATH="${CONDA_PREFIX}/include:${CPLUS_INCLUDE_PATH:-}"

require_under_prefix() {
  local label=$1
  local value=$2
  if [[ -z "${value}" ]]; then
    return
  fi
  case "${value}" in
    "${CONDA_PREFIX}"|"${CONDA_PREFIX}"/*) ;;
    *)
      echo "Error: ${label} is outside pixi/conda prefix: ${value}" >&2
      exit 1
      ;;
  esac
}

ROOT_CMAKE_DIR="@ROOT_CMAKE_DIR@"
YAML_CPP_CMAKE_DIR="@YAML_CPP_CMAKE_DIR@"
CORRECTIONLIB_CMAKE_DIR="@CORRECTIONLIB_CMAKE_DIR@"
CORRECTIONLIB_LIB_DIR="@CORRECTIONLIB_LIB_DIR@"
CC_COMPILER="@CC_COMPILER@"
CXX_COMPILER="@CXX_COMPILER@"
CMAKE_PREFIX_PATH_ARG="@CMAKE_PREFIX_PATH@"
CMAKE_LINK_FLAGS="@CMAKE_LINK_FLAGS@"
CMAKE_RPATH="@CMAKE_RPATH@"

require_under_prefix ROOT_CMAKE_DIR "${ROOT_CMAKE_DIR}"
require_under_prefix YAML_CPP_CMAKE_DIR "${YAML_CPP_CMAKE_DIR}"
require_under_prefix CORRECTIONLIB_CMAKE_DIR "${CORRECTIONLIB_CMAKE_DIR}"
require_under_prefix CORRECTIONLIB_LIB_DIR "${CORRECTIONLIB_LIB_DIR}"
require_under_prefix CC_COMPILER "${CC_COMPILER}"
require_under_prefix CXX_COMPILER "${CXX_COMPILER}"

if [[ ! -f "${ROOT_CMAKE_DIR}/ROOTConfig.cmake" ]]; then
  echo "Error: ROOTConfig.cmake is missing under pixi/conda prefix: ${ROOT_CMAKE_DIR}" >&2
  exit 1
fi
if [[ ! -f "${YAML_CPP_CMAKE_DIR}/yaml-cpp-config.cmake" && ! -f "${YAML_CPP_CMAKE_DIR}/yaml-cppConfig.cmake" ]]; then
  echo "Error: yaml-cpp CMake config is missing under pixi/conda prefix: ${YAML_CPP_CMAKE_DIR}" >&2
  exit 1
fi
if [[ ! -f "${CORRECTIONLIB_CMAKE_DIR}/correctionlibConfig.cmake" && ! -f "${CORRECTIONLIB_CMAKE_DIR}/correctionlib-config.cmake" ]]; then
  echo "Error: correctionlib CMake config is missing under pixi/conda prefix: ${CORRECTIONLIB_CMAKE_DIR}" >&2
  exit 1
fi
if [[ ! -x "${CC_COMPILER}" ]]; then
  echo "Error: pixi/conda C compiler is missing or not executable: ${CC_COMPILER}" >&2
  exit 1
fi
if [[ ! -x "${CXX_COMPILER}" ]]; then
  echo "Error: pixi/conda C++ compiler is missing or not executable: ${CXX_COMPILER}" >&2
  exit 1
fi
export CC="${CC_COMPILER}"
export CXX="${CXX_COMPILER}"
if [[ -n "${CORRECTIONLIB_LIB_DIR}" ]]; then
  export LD_LIBRARY_PATH="${CORRECTIONLIB_LIB_DIR}:${LD_LIBRARY_PATH}"
  export LIBRARY_PATH="${CORRECTIONLIB_LIB_DIR}:${LIBRARY_PATH}"
fi

WORKDIR=$(pwd)
REPO_STAMP="$(
  env -u PYTHONHOME -u PYTHONPATH python3 - <<'PY'
from pathlib import Path
import hashlib

h = hashlib.sha256()
with Path("repo.tar.gz").open("rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        h.update(chunk)
print(h.hexdigest()[:16])
PY
)"
REPO_DIR="${WORKDIR}/repo_${REPO_STAMP}"
EXTRACT_STAMP="${REPO_DIR}/.extract_complete_${REPO_STAMP}"
EXTRACT_LOCK="${WORKDIR}/.extract_${REPO_STAMP}.lock"
BUILD_LOCK="${WORKDIR}/.build_${REPO_STAMP}.lock"

if ! command -v flock >/dev/null 2>&1; then
  echo "Error: flock is required to serialize shared Condor worker setup" >&2
  exit 1
fi

(
  flock 200
  if [ ! -f "${EXTRACT_STAMP}" ]; then
    mkdir -p "${REPO_DIR}"
    tar -xzf repo.tar.gz -C "${REPO_DIR}" --strip-components=0
    touch "${EXTRACT_STAMP}"
  fi
) 200>"${EXTRACT_LOCK}"

detect_build_jobs() {
  if [[ -n "${BUILD_JOBS:-}" && "${BUILD_JOBS}" != "auto" && "${BUILD_JOBS}" != "all" ]]; then
    echo "${BUILD_JOBS}"
    return
  fi
  if command -v nproc >/dev/null 2>&1; then
    nproc
    return
  fi
  getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1
}

(
  flock 200
  if [ ! -x "${REPO_DIR}/build/nano_run" ]; then
    BUILD_THREADS="$(detect_build_jobs)"
    echo "Building nano.cpp with ${BUILD_THREADS} parallel jobs"
    cmake -S "${REPO_DIR}" -B "${REPO_DIR}/build" \
      -DCMAKE_CXX_COMPILER="${CXX_COMPILER}" \
      -DCMAKE_PREFIX_PATH="${CMAKE_PREFIX_PATH_ARG}" \
      -DROOT_DIR="${ROOT_CMAKE_DIR}" \
      -Dcorrectionlib_DIR="${CORRECTIONLIB_CMAKE_DIR}" \
      -Dyaml-cpp_DIR="${YAML_CPP_CMAKE_DIR}" \
      -DCMAKE_EXE_LINKER_FLAGS="${CMAKE_LINK_FLAGS}" \
      -DCMAKE_SHARED_LINKER_FLAGS="${CMAKE_LINK_FLAGS}" \
      -DCMAKE_MODULE_LINKER_FLAGS="${CMAKE_LINK_FLAGS}" \
      -DCMAKE_BUILD_RPATH="${CMAKE_RPATH}" \
      -DCMAKE_INSTALL_RPATH="${CMAKE_RPATH}"
    cmake --build "${REPO_DIR}/build" -j "${BUILD_THREADS}"
  fi
) 200>"${BUILD_LOCK}"

JOB_INDEX=$1
TREE_NAME=$2
NUM_EVENTS=$3
CONFIG=$4
CHANNEL=$5
VARIATIONS=$6
RUN_DATA=$7
DOWNLOAD_FILE="${DOWNLOAD_FILE:-${8:-false}}"

STAGE_DIR="${_CONDOR_SCRATCH_DIR:-${TMPDIR:-${WORKDIR}}}"
mkdir -p "${STAGE_DIR}"

LOCAL_OUTPUT="${STAGE_DIR}/local_output_${JOB_INDEX}.root"

if [[ "${CONFIG}" != /* ]]; then
  CONFIG="${WORKDIR}/${CONFIG}"
fi

eval "$(
  env -u PYTHONHOME -u PYTHONPATH python3 - "${JOB_INDEX}" <<'PY'
import json
import shlex
import sys

job_index = int(sys.argv[1])

with open("job_manifest.json") as handle:
    jobs = {int(job["index"]): job for job in json.load(handle)["jobs"]}

job = jobs[job_index]
print("FINAL_OUTPUT=" + shlex.quote(job["output_file"]))
print("INPUTS=" + shlex.quote(",".join(job["inputs"])))
PY
)"

LOCAL_STEM="${LOCAL_OUTPUT%.root}"
FINAL_STEM="${FINAL_OUTPUT%.root}"

should_download() {
  case "$1" in
    true|TRUE|True|1|yes|YES|y|Y|on|ON|On) return 0 ;;
    *) return 1 ;;
  esac
}

is_remote_input() {
  local path=$1
  [[ "${path}" == root://* ]]
}

variation_file() {
  local base=$1
  local variation=$2

  if [[ "${base}" == *.root ]]; then
    echo "${base%.root}_${variation}.root"
  else
    echo "${base}_${variation}"
  fi
}

run_one_input() {
  local input=$1
  local output=$2
  local cmd=(
    "${REPO_DIR}/build/nano_run"
    --input-files "${input}"
    --output-file "${output}"
    --tree-name "${TREE_NAME}"
    --num-events "${NUM_EVENTS}"
    --channel "${CHANNEL}"
    --config "${CONFIG}"
  )

  cmd+=(--variations "${VARIATIONS}")
  if should_download "${RUN_DATA}"; then
    cmd+=(--run-data)
  fi

  printf "Running command:"
  printf " %q" "${cmd[@]}"
  printf "\n"

  (cd "${REPO_DIR}" && "${cmd[@]}")
}

parse_variations() {
  local in_var=$1
  IFS=',' read -r -a out <<< "${in_var}"
  for v in "${out[@]}"; do
    [[ -n "${v}" ]] && echo "${v}"
  done
}

IFS=',' read -r -a RAW_INPUTS <<< "${INPUTS}"
if (( ${#RAW_INPUTS[@]} == 0 )); then
  echo "No input files in manifest job ${JOB_INDEX}" >&2
  exit 1
fi

DOWNLOAD_REMOTE=false
if should_download "${DOWNLOAD_FILE}"; then
  for input_file in "${RAW_INPUTS[@]}"; do
    if is_remote_input "${input_file}"; then
      DOWNLOAD_REMOTE=true
      break
    fi
  done
fi

WORK_INPUTS=()
TO_CLEAN=()
WORK_INPUTS=("${RAW_INPUTS[@]}")

run_limited() {
  local seconds=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "${seconds}" "$@"
  else
    "$@"
  fi
}

remote_host() {
  local remote=$1
  local without_scheme="${remote#root://}"
  echo "${without_scheme%%/*}"
}

remote_path() {
  local remote=$1
  local without_scheme="${remote#root://}"
  local host="${without_scheme%%/*}"
  local path="${without_scheme#${host}}"
  while [[ "${path}" == //* ]]; do
    path="${path#/}"
  done
  if [[ "${path}" != /* ]]; then
    path="/${path}"
  fi
  echo "${path}"
}

diagnose_remote_input() {
  local remote=$1
  local host
  local path
  host="$(remote_host "${remote}")"
  path="$(remote_path "${remote}")"

  log_step "Remote input diagnostic: host=${host} path=${path}"
  if command -v xrdfs >/dev/null 2>&1; then
    log_step "Running xrdfs stat with ${SCALE_FACTOR_XRD_STAT_TIMEOUT}s limit"
    if run_limited "${SCALE_FACTOR_XRD_STAT_TIMEOUT}" xrdfs "root://${host}" stat "${path}" >&2; then
      log_step "xrdfs stat succeeded for ${remote}"
    else
      log_step "Warning: xrdfs stat failed or timed out for ${remote}"
    fi
  else
    log_step "Warning: xrdfs is not available in PATH"
  fi
}

candidate_remote_inputs() {
  local source_file=$1
  local source_host
  local source_path
  source_host="$(remote_host "${source_file}")"
  source_path="$(remote_path "${source_file}")"

  echo "${source_file}"

  local seen=",${source_host},"
  local redirector
  IFS=',' read -r -a redirectors <<< "${SCALE_FACTOR_XRD_REDIRECTORS}"
  for redirector in "${redirectors[@]}"; do
    redirector="${redirector//[[:space:]]/}"
    [[ -z "${redirector}" ]] && continue
    case "${seen}" in
      *",${redirector},"*) continue ;;
    esac
    seen="${seen}${redirector},"
    echo "root://${redirector}/${source_path}"
  done
}

log_step "Job context: job_index=${JOB_INDEX} host=$(hostname -f 2>/dev/null || hostname) workdir=${WORKDIR} stage_dir=${STAGE_DIR}"
log_step "Input staging: DOWNLOAD_FILE=${DOWNLOAD_FILE} XRD_NETWORKSTACK=${XRD_NETWORKSTACK} XRD_CONNECTIONWINDOW=${XRD_CONNECTIONWINDOW} XRD_REQUESTTIMEOUT=${XRD_REQUESTTIMEOUT} SCALE_FACTOR_XRD_REDIRECTORS=${SCALE_FACTOR_XRD_REDIRECTORS}"
log_step "Tools: xrdcp=$(command -v xrdcp 2>/dev/null || echo missing) xrdfs=$(command -v xrdfs 2>/dev/null || echo missing) voms-proxy-info=$(command -v voms-proxy-info 2>/dev/null || echo missing)"
if [[ -n "${X509_USER_PROXY:-}" ]]; then
  log_step "X509_USER_PROXY=${X509_USER_PROXY}"
  ls -l "${X509_USER_PROXY}" >&2 2>/dev/null || true
  if command -v voms-proxy-info >/dev/null 2>&1; then
    log_step "Proxy time left:"
    voms-proxy-info -timeleft >&2 || true
  fi
else
  log_step "Warning: X509_USER_PROXY is not set"
fi
log_step "Resolved manifest inputs (${#RAW_INPUTS[@]} files):"
for input_file in "${RAW_INPUTS[@]}"; do
  log_step "  ${input_file}"
done

prepare_input() {
  local index=$1
  local source_file=$2
  local max_rounds=2
  local round=1
  local wait_seconds=5

  if [[ "${DOWNLOAD_REMOTE}" == "true" && "${source_file}" == root://* ]]; then
    local local_name="${STAGE_DIR}/download_${JOB_INDEX}_${index}_$(basename "${source_file}")"
    mapfile -t SOURCE_CANDIDATES < <(candidate_remote_inputs "${source_file}")
    log_step "Copying remote input to ${local_name}"
    for candidate in "${SOURCE_CANDIDATES[@]}"; do
      log_step "  candidate: ${candidate}"
    done
    while (( round <= max_rounds )); do
      local candidate
      for candidate in "${SOURCE_CANDIDATES[@]}"; do
        diagnose_remote_input "${candidate}"
        log_step "xrdcp attempt round ${round}/${max_rounds}: ${candidate}"
        if xrdcp -f --nopbar "${candidate}" "${local_name}"; then
          ls -lh "${local_name}" >&2 || true
          log_step "Copied remote input from ${candidate} to ${local_name}"
          TO_CLEAN+=("${local_name}")
          echo "${local_name}"
          return
        fi
        log_step "Warning: xrdcp failed for ${candidate} in round ${round}/${max_rounds}" >&2
      done
      if (( round >= max_rounds )); then
        log_step "Error: failed to copy ${source_file} to ${local_name} after ${max_rounds} rounds over ${#SOURCE_CANDIDATES[@]} redirector candidates" >&2
        return 1
      fi
      log_step "Warning: all xrdcp candidates failed for ${source_file} in round ${round}/${max_rounds}; retrying in ${wait_seconds}s" >&2
      sleep "${wait_seconds}"
      round=$((round + 1))
    done
  fi

  echo "${source_file}"
}

if [[ "${DOWNLOAD_REMOTE}" == "false" ]]; then
  run_one_input "${INPUTS}" "${LOCAL_OUTPUT}"
else
  mapfile -t VARIATION_NAMES < <(parse_variations "${VARIATIONS}")
  for i in "${!WORK_INPUTS[@]}"; do
    input_file="$(prepare_input "${i}" "${WORK_INPUTS[$i]}")"
    piece_base="${STAGE_DIR}/piece_${JOB_INDEX}_${i}"
    run_one_input "${input_file}" "${piece_base}"
    TO_CLEAN+=("${piece_base}" "${piece_base}.root")
  done

  for var in "${VARIATION_NAMES[@]}"; do
    VARIANT_FILES=()
    for i in "${!WORK_INPUTS[@]}"; do
      piece_base="${STAGE_DIR}/piece_${JOB_INDEX}_${i}"
      piece_var="$(variation_file "${piece_base}" "${var}")"
      VARIANT_FILES+=("${piece_var}")
      TO_CLEAN+=("${piece_var}")
    done

    local_var_output="$(variation_file "${LOCAL_OUTPUT}" "${var}")"
    if (( ${#VARIANT_FILES[@]} == 1 )); then
      mv -f "${VARIANT_FILES[0]}" "${local_var_output}"
    else
      echo "Merging ${#VARIANT_FILES[@]} pieces into ${local_var_output} (variation=${var})"
      hadd -f "${local_var_output}" "${VARIANT_FILES[@]}"
    fi
  done
fi

copy_output() {
  local local_file=$1
  local final_file=$2

  if [[ "${final_file}" == root://* ]]; then
    log_step "Copying ${local_file} to ${final_file}"
    xrdcp --silent -p -f "${local_file}" "${final_file}"
  elif [[ "${final_file}" == /eos/cms* ]]; then
    local eos_host="root://eoscms.cern.ch"
    local remote_output="${eos_host}//${final_file}"
    log_step "Copying ${local_file} to ${remote_output}"
    xrdcp --silent -p -f "${local_file}" "${remote_output}"
  elif [[ "${final_file}" == /eos/user* ]]; then
    local eos_host="root://eosuser.cern.ch"
    local remote_output="${eos_host}//${final_file}"
    log_step "Copying ${local_file} to ${remote_output}"
    xrdcp --silent -p -f "${local_file}" "${remote_output}"
  elif [[ "${final_file}" == /eos/uscms* ]]; then
    local eos_host="root://cmseos.fnal.gov"
    local remote_output="${eos_host}//${final_file}"
    log_step "Copying ${local_file} to ${remote_output}"
    xrdcp --silent -p -f "${local_file}" "${remote_output}"
  else
    mkdir -p "$(dirname "${final_file}")"
    log_step "Copying ${local_file} to ${final_file}"
    cp "${local_file}" "${final_file}"
  fi
}

shopt -s nullglob
copied=0

for local_file in "${LOCAL_STEM}"_*.root; do
  suffix="${local_file#${LOCAL_STEM}}"
  copy_output "${local_file}" "${FINAL_STEM}${suffix}"
  copied=$((copied + 1))
done

if [[ ${copied} -eq 0 ]]; then
  echo "No variation output files matched ${LOCAL_STEM}_*.root" >&2
  exit 1
fi

for file in "${TO_CLEAN[@]}"; do
  rm -f "${file}"
done

touch ${WORKDIR}/dummy.cc
