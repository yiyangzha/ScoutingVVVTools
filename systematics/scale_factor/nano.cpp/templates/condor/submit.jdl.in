universe = vanilla
executable = process.sh

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files = repo.tar.gz,worker_runtime.tar.gz,config_snapshot.yaml,job_manifest.json,job_manifest.tsv,x509up_proxy
transfer_output_files = ""
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
on_exit_hold_reason = ifThenElse(ExitBySignal, strcat("Job exited by signal ", ExitSignal), strcat("Job exited with nonzero exit code ", ExitCode))

+AcctGroup = "cms"
+HepJob_WallTime = "mid"

environment = "DOWNLOAD_FILE=@DOWNLOAD_REMOTE_INPUTS@"
output = logs/$(Cluster).$(Process).out
error = logs/$(Cluster).$(Process).err
log = logs/$(Cluster).log

request_cpus = 1
request_disk = @REQUEST_DISK_KB@

arguments = $(job_index) @TREE_NAME@ @NUM_EVENTS@ config_snapshot.yaml @CHANNEL@ @VARIATIONS@ @RUN_DATA@
max_materialize = 60
max_idle = 20
queue job_index from job_indices.txt
