#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"
mkdir -p logs

JOB_COUNT="@NUM_JOBS@"
TREE_NAME="@TREE_NAME@"
NUM_EVENTS="@NUM_EVENTS@"
CONFIG="config_snapshot.yaml"
CHANNEL="@CHANNEL@"
VARIATIONS="@VARIATIONS@"
RUN_DATA="@RUN_DATA@"
DOWNLOAD_REMOTE_INPUTS="@DOWNLOAD_REMOTE_INPUTS@"

HOSTNAME_FULL="$(hostname -f 2>/dev/null || hostname)"

is_lxplus_host() {
  [[ "${HOSTNAME_FULL}" == lxplus* || "${HOSTNAME_FULL}" == lxplus*.cern.ch ]]
}

load_cern_eossubmit() {
  if [[ "${SCRIPT_DIR}" != /eos/* ]]; then
    return
  fi
  if ! is_lxplus_host; then
    return
  fi

  if ! command -v module >/dev/null 2>&1; then
    for module_init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash; do
      if [[ -r "${module_init}" ]]; then
        # shellcheck disable=SC1090
        source "${module_init}"
        break
      fi
    done
  fi

  if ! command -v module >/dev/null 2>&1; then
    echo "Error: /eos submit directory detected on CERN lxplus, but the module command is not available" >&2
    echo "Please run this from a lxplus shell with CERN environment modules enabled." >&2
    exit 1
  fi

  echo "Detected CERN lxplus EOS workdir; enabling EosSubmit schedds"
  module load lxbatch/eossubmit
}

stage_x509_proxy() {
  local source_proxy="${X509_USER_PROXY:-}"
  if [[ -z "${source_proxy}" ]]; then
    source_proxy="/tmp/x509up_u$(id -u)"
  fi

  local target_proxy="${SCRIPT_DIR}/x509up_proxy"
  if [[ ! -f "${source_proxy}" ]]; then
    echo "Warning: no X509 proxy found at ${source_proxy}; remote /store access may fail" >&2
    return
  fi

  if [[ "${source_proxy}" != "${target_proxy}" ]]; then
    cp "${source_proxy}" "${target_proxy}"
  fi
  chmod 600 "${target_proxy}"
  echo "Staged X509 proxy for workers: ${target_proxy}"
}

if [[ "${HOSTNAME_FULL}" == lxlogin* || "${HOSTNAME_FULL}" == lxlogin*.ihep.ac.cn ]]; then
  if ! command -v hep_sub >/dev/null 2>&1; then
    echo "Error: lxlogin host detected, but hep_sub is not available in PATH" >&2
    exit 1
  fi
  stage_x509_proxy
  echo "Detected lxlogin host ${HOSTNAME_FULL}; submitting with IHEP HepJob"
  hep_sub \
    ./process.sh \
    -g cms \
    -wt mid \
    -n "${JOB_COUNT}" \
    -dir "${SCRIPT_DIR}" \
    -o "logs/%{ClusterId}.%{ProcId}.out" \
    -e "logs/%{ClusterId}.%{ProcId}.err" \
    -argu "%{ProcId}" "${TREE_NAME}" "${NUM_EVENTS}" "${CONFIG}" "${CHANNEL}" "${VARIATIONS}" "${RUN_DATA}" "${DOWNLOAD_REMOTE_INPUTS}"
else
  if ! command -v condor_submit >/dev/null 2>&1; then
    echo "Error: condor_submit is not available in PATH" >&2
    exit 1
  fi
  if is_lxplus_host; then
    load_cern_eossubmit
    if [[ ! -f submit_lxplus.jdl ]]; then
      echo "Error: lxplus host detected, but submit_lxplus.jdl was not generated" >&2
      echo "Regenerate this job directory with nano_make_condor or pixi run python3 run.py 11." >&2
      exit 1
    fi
    echo "Detected lxplus host ${HOSTNAME_FULL}; submitting with CERN HTCondor settings"
    condor_submit "$@" submit_lxplus.jdl
  else
    echo "Submitting with native HTCondor"
    condor_submit "$@" submit.jdl
  fi
fi
