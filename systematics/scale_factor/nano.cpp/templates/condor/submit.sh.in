#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"
mkdir -p logs

JOB_COUNT="@NUM_JOBS@"
TREE_NAME="@TREE_NAME@"
NUM_EVENTS="@NUM_EVENTS@"
CONFIG="config_snapshot.yaml"
CHANNEL="@CHANNEL@"
VARIATIONS="@VARIATIONS@"
RUN_DATA="@RUN_DATA@"

HOSTNAME_FULL="$(hostname -f 2>/dev/null || hostname)"

if [[ "${HOSTNAME_FULL}" == lxlogin* || "${HOSTNAME_FULL}" == lxlogin*.ihep.ac.cn ]]; then
  if ! command -v hep_sub >/dev/null 2>&1; then
    echo "Error: lxlogin host detected, but hep_sub is not available in PATH" >&2
    exit 1
  fi
  echo "Detected lxlogin host ${HOSTNAME_FULL}; submitting with IHEP HepJob"
  hep_sub \
    ./process.sh \
    -g cms \
    -wt mid \
    -n "${JOB_COUNT}" \
    -dir "${SCRIPT_DIR}" \
    -o "logs/%{ClusterId}.%{ProcId}.out" \
    -e "logs/%{ClusterId}.%{ProcId}.err" \
    -argu "%{ProcId}" "${TREE_NAME}" "${NUM_EVENTS}" "${CONFIG}" "${CHANNEL}" "${VARIATIONS}" "${RUN_DATA}"
else
  if ! command -v condor_submit >/dev/null 2>&1; then
    echo "Error: condor_submit is not available in PATH" >&2
    exit 1
  fi
  echo "Submitting with native HTCondor"
  condor_submit "$@" submit.jdl
fi
